# =============================================================
# Frontend (Next.js)
# =============================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_FALLBACK=true

# =============================================================
# cinex backend (root-level implementation: cinex/, services/)
# NOTE: the backend/ directory has its own backend/.env.example
# =============================================================
SERVICE=orchestrator

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cinexchange
CLICKHOUSE_URL=http://clickhouse:8123
JWT_SECRET=changeme
DEMO_PRODUCER_ID=11111111-1111-1111-1111-111111111111

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Two ways to reach the same model. Leave GEMINI_USE_VERTEX=false for the Gemini
# Developer API, which authenticates with the GEMINI_API_KEY above.
#
# Set it to true for Vertex AI - the Google-Cloud-hosted path. There the SDK
# authenticates with Application Default Credentials (the service account
# attached to the Cloud Run / GKE workload), so GEMINI_API_KEY is NOT used or
# even passed, and the deployment carries no long-lived secret to leak. When
# GEMINI_USE_VERTEX=true, GCP_PROJECT and GCP_LOCATION must both be non-empty or
# startup fails with an LLMError.
GEMINI_USE_VERTEX=false
GCP_PROJECT=cine-xchange
GCP_LOCATION=us-central1

# Browser origins allowed to call this API (CORS). One origin, or several
# comma-separated. Never "*": the API is called with Authorization headers and
# allow_credentials=True, and browsers reject a wildcard origin on a credentialed
# request. Blank means no cross-origin browser access at all.
FRONTEND_ORIGIN=http://localhost:3000

APPROVAL_THRESHOLD_PCT=10.0
NEGOTIATION_MAX_ROUNDS=3
VENDOR_TIMEOUT_S=5.0
LLM_TIMEOUT_S=90
INSURANCE_RIDER_THRESHOLD=50000

PRODUCER_AGENT_URL=http://producer-agent:8001/mcp
SCOUT_AGENT_URL=http://scout-agent:8002/mcp
NEGOTIATION_AGENT_URL=http://negotiation-agent:8003/mcp
COMPLIANCE_AGENT_URL=http://compliance-agent:8004/mcp
RECOVERY_AGENT_URL=http://recovery-agent:8005/mcp
LLM_MAX_CONCURRENCY=4
LLM_MAX_ATTEMPTS=4
