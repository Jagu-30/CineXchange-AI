APP_ENV=development
PORT=8000
HOST=0.0.0.0

USE_MOCK_BACKEND=true
USE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Grafana
GRAFANA_MODE=mock
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_MCP_URL=
GRAFANA_ORG_ID=
GRAFANA_INCIDENT_LABEL=cinexchange

# ClickHouse
CLICKHOUSE_MODE=mock
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=cinexchange
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true

# Policies
MAX_NEGOTIATION_ROUNDS=3
TARGET_SAVINGS_PERCENT=8.0
MIN_ACCEPTABLE_QUALITY=85.0
HIGH_VALUE_APPROVAL_THRESHOLD=1000000.0
DEFAULT_CURRENCY=INR
AUTO_APPROVE_LOW_RISK=true

# API
FRONTEND_ORIGIN=http://localhost:3000
